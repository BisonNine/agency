#!/bin/sh
# Sets up the system-wide install: the agency account with its home
# /home/agency, the data directory /opt/agency owned by it, and the service (written and started by `agency install --package`).
# An install the package did not make is left exactly as it is.
set -e

ACCOUNT=agency
DATA_DIR=/opt/agency
ACCOUNT_HOME=/home/agency
UNIT=/etc/systemd/system/agency.service
STATE_DIR=/var/lib/agency
MARKER='# Managed by the agency Debian package'
# Set by create_account when it creates the account, for the install message.
ACCOUNT_FLAG=

systemd_running() {
    command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

# foreign_install prints where an install the package did not make is: a
# unit without the package's marker, or a data directory the package did
# not create that belongs to another account.
foreign_install() {
    if [ -f "$UNIT" ]; then
        if [ "$(head -n 1 "$UNIT")" != "$MARKER" ]; then
            echo "$UNIT"
        fi
        return 0
    fi
    if [ -d "$DATA_DIR" ] && [ ! -e "$STATE_DIR/created-home" ] &&
        [ "$(stat -c %U "$DATA_DIR")" != "$ACCOUNT" ]; then
        echo "$DATA_DIR"
    fi
}

# create_account creates the system account, its home and its group unless
# they exist, recording what it created so purge removes only that. An
# account that exists keeps the home it has.
create_account() {
    if getent passwd "$ACCOUNT" >/dev/null; then
        return 0
    fi
    mkdir -p "$STATE_DIR"
    if [ ! -e "$ACCOUNT_HOME" ]; then
        touch "$STATE_DIR/created-account-home"
    fi
    if getent group "$ACCOUNT" >/dev/null; then
        adduser --system --ingroup "$ACCOUNT" --home "$ACCOUNT_HOME" \
            --shell /bin/bash "$ACCOUNT" >/dev/null
    else
        adduser --system --group --home "$ACCOUNT_HOME" \
            --shell /bin/bash "$ACCOUNT" >/dev/null
        touch "$STATE_DIR/created-group"
    fi
    touch "$STATE_DIR/created-account"
    ACCOUNT_FLAG=--account-created
}

# create_data_dir creates /opt/agency owned by the account unless it exists.
create_data_dir() {
    if [ -d "$DATA_DIR" ]; then
        return 0
    fi
    mkdir -p "$STATE_DIR"
    install -d -m 0700 -o "$ACCOUNT" -g "$(id -gn "$ACCOUNT")" "$DATA_DIR"
    touch "$STATE_DIR/created-home"
}

case "$1" in
    configure | abort-upgrade | abort-remove | abort-deconfigure)
        where=$(foreign_install)
        if [ -n "$where" ]; then
            # A unit running this package's binary picks up the new version.
            if [ -f "$UNIT" ] && grep -q '^ExecStart=/usr/bin/agency\( .*\)\{0,1\}$' "$UNIT" &&
                systemd_running && systemctl is-active --quiet agency.service; then
                systemctl try-restart agency.service >/dev/null 2>&1 || true
            fi
            echo "An existing Agency install was found and left unchanged ($where)."
            exit 0
        fi
        create_account
        create_data_dir
        AGENCY_HOME="$DATA_DIR" /usr/bin/agency install --package $ACCOUNT_FLAG
        ;;
esac

exit 0
