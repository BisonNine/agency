#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        if systemctl is-active --quiet agency.service; then
            systemctl try-restart agency.service >/dev/null 2>&1 || true
        elif [ -z "${2:-}" ] && [ ! -f /etc/systemd/system/agency.service ]; then
            echo "Agency installed (/usr/bin/agency, /usr/bin/agency-auth)."
            echo "Next: run 'sudo agency install' (system service) or 'agency install' (user service)"
            echo "to create the WebUI admin account and start the service."
        fi
    elif [ -z "${2:-}" ] && [ ! -f /etc/systemd/system/agency.service ]; then
        echo "Agency installed (/usr/bin/agency, /usr/bin/agency-auth)."
        echo "Next: run 'sudo agency install' (system service) or 'agency install' (user service)"
        echo "to create the WebUI admin account and start the service."
    fi
fi

exit 0
