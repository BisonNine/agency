#!/bin/sh
# Stops and removes the service on removal (`apt remove`, `apt purge`),
# never on an upgrade (`upgrade`, `failed-upgrade`): the new postinst
# restarts it. The data directory and the account stay until purge.
set -e

case "$1" in
    remove | deconfigure)
        if [ -x /usr/bin/agency ]; then
            /usr/bin/agency uninstall --package
        fi
        ;;
esac

exit 0
